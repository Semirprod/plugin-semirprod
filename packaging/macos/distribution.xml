<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Semirprod pour OBS</title>
    <organization>fr.semirprod</organization>

    <!-- Domaine : le dossier de l'utilisateur courant, et LUI SEUL.

         Ce n'est pas un choix de confort. Sur Apple Silicon, OBS ne cherche
         ses plugins qu'a un seul endroit :
           ~/Library/Application Support/obs-studio/plugins/<module>.plugin
         Les emplacements systeme (/Library) sont derriere un `#ifndef
         __aarch64__` dans le code d'OBS. Un paquet installe en
         « localSystem » s'installerait donc sans erreur et resterait
         invisible pour OBS — la panne la plus couteuse a diagnostiquer.

         Effet de bord bienvenu : aucune elevation de privileges, donc aucun
         mot de passe administrateur demande a l'utilisateur. -->
    <domains enable_anywhere="false"
             enable_currentUserHome="true"
             enable_localSystem="false"/>

    <!-- OBS 32.0 minimum : c'est le plancher impose par le SDK libobs contre
         lequel le module est compile. En
         dessous, libobs refuse le module au chargement. macOS 13 vient de
         CMAKE_OSX_DEPLOYMENT_TARGET, aligne sur OBS lui-meme. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>

    <!-- require-scripts passe a true : avec false, Installer n'evalue aucun
         JavaScript, et l'installation-check ci-dessous serait ignoree. -->
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>

    <!-- OBS ouvert = peut-etre un direct en cours. Meme regle que l'installeur
         Windows : on refuse, on ne ferme rien, et rien n'est touche.

         Pas de <must-close> : Installer proposerait de fermer OBS lui-meme, donc
         de couper un direct d'un clic. Pas de system.run non plus : il exige
         allow-external-scripts, qui affiche un avertissement a l'utilisateur.

         Ce controle sert a donner un message lisible, il n'est PAS la garantie :
         il ne tourne qu'a l'ouverture du paquet (OBS peut etre lance ensuite), et
         l'API peut ne rien voir selon la session (sudo installer). La garantie est
         le preinstall, qui s'execute au moment d'installer.

         Toute erreur de l'API laisse donc passer : le preinstall tranche. -->
    <installation-check script="obsIsClosed();"/>
    <script>
    <![CDATA[
    function obsText(key, fallback) {
        var value = system.localizedString(key);
        return (value && value !== key) ? value : fallback;
    }
    function obsIsClosed() {
        var running = null;
        try {
            running = system.applications.fromIdentifier('com.obsproject.obs-studio');
        } catch (e) {
            return true;
        }
        // Tableau d'applications selon les versions de macOS, ou objet seul.
        if (running && (running.length === undefined || running.length > 0)) {
            my.result.type = 'Fatal';
            my.result.title = obsText('OBS_RUNNING_TITLE', 'OBS');
            my.result.message = obsText('OBS_RUNNING_MESSAGE',
                'OBS est ouvert. Ferme-le avant d\'installer. / OBS is open. Close it before installing.');
            return false;
        }
        return true;
    }
    ]]>
    </script>

    <!-- Logo Semirprod, en bas a gauche du panneau.
         `scaling="none"` parce que l'image est deja generee a la bonne taille
         par build_pkg.sh (sips depuis logo.png) : laisser l'installeur mettre
         a l'echelle un PNG de 1080x1080 donne un rendu mou.
         La variante darkAqua est la MEME image — le logo est lisible sur les
         deux fonds — mais la declarer evite que macOS applique son propre
         traitement au fichier clair. -->
    <background file="background.png" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background.png" alignment="bottomleft" scaling="none"/>

    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Semirprod pour OBS">
        <pkg-ref id="fr.semirprod.obs-plugin"/>
    </choice>
    <pkg-ref id="fr.semirprod.obs-plugin">semirprod-studio.pkg</pkg-ref>
</installer-gui-script>
